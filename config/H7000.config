# BBK S5 (H7000) - device specific kernel configuration
# merged on top of arch/arm64/configs/vendor/wayne-perf_defconfig
#
# NOTE: do not put symbol names inside comments here - merge_config.sh treats
# any line containing a symbol pattern as a setting and would corrupt .config.

# Platform
CONFIG_ARCH_SDM660=y

# Heterogeneous CPU masks: the vendor defconfig leaves them empty, which modern
# kconfig rejects (and then prompts interactively, hanging CI). 0 = all CPUs.
CONFIG_LITTLE_CPU_MASK=0
CONFIG_BIG_CPU_MASK=0

# This base tree is maintained on the CASS/EEVDF scheduler path: the WALT-only
# code it contains does not compile (stale backports), and the maintainer's own
# device configs leave WALT disabled as well.
# CONFIG_SCHED_WALT is not set

# Cortex-A53 erratum 843419 veneer code in arch/arm64/kernel/module-plts.c
# references aarch64_insn_* helpers without including asm/insn.h; the
# maintainer's device configs leave it disabled.
# CONFIG_ARM64_ERRATUM_843419 is not set

# Kernel release string
CONFIG_LOCALVERSION="-h7000"

# Display backlight: KTZ8864 I2C init driver + PM660L PWM dimming
CONFIG_BACKLIGHT_LCD_SUPPORT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8864=y

# Touchscreen: FocalTech FTS (driver lives in focaltech_touch/)
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_DIRECTORY="focaltech_touch"

# WLAN: qcacld-3.0 (WCN3990)
CONFIG_QCA_CLD_WLAN=y

# Pstore / ramoops console for bring-up debugging
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Keep cmdline/ramdisk handling compatible with the vendor boot image
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
