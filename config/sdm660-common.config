# BBK S5 (H7000) - common sdm660 kernel configuration

# Auto local version (embeds git revision in the kernel release string)
CONFIG_LOCALVERSION_AUTO=y

# No BBK haptics driver: the board has no haptics motor
# CONFIG_INPUT_HBTP_INPUT is not set

# Keep ramdisk contents (vendor boot ramdisk is packed separately)
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
